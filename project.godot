; Engine configuration file.
; Mikan the Desktop Cat — a Hack Club Playground submission

config_version=5

[application]

config/name="Mikan the Desktop Cat"
config/description="A tiny orange cat that lives on your desktop. She walks, naps, and can be picked up and dropped."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://assets/sprites/idle1.png"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/borderless=true
window/size/transparent=true
window/size/always_on_top=true
window/per_pixel_transparency/allowed=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
